{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "strict": true,

    "skipLibCheck": true,

    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,

    "types": [
      "node"
    ],

    "outDir": "dist"
  },

  "include": [
    "src"
  ]
}
